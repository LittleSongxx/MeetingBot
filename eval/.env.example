# =============================================================================
# 评测环境变量模板（复制为 eval/.env 后填写；eval/.env 已被 gitignore）
#
# 必填：
#   MYSQL_PASSWORD / MYSQL_ROOT_PASSWORD  评测库口令（与演示栈不同即可）
#   JWT_SECRET                             openssl rand -hex 32 的输出
#   APP_ADMIN_PASSWORD                     评测环境管理员口令
#   DASHSCOPE_API_KEY                      百炼 Key（ASR + LLM 共用；也可拆分 ASR/LLM Key）
# 模型建议：
#   ASR_MODEL=paraformer-v2                录音文件识别 + 说话人分离（当前链路验证可用）
#   LLM_MODEL=qwen3.8-max-0902             质量基线（与演示栈一致，适合正式评测）
#   LLM_MODEL=qwen-plus                    低成本回归/日常对比（如果账号有权限）
# =============================================================================

# ---------- MySQL（评测库，与演示栈隔离） ----------
MYSQL_DATABASE=ai_meeting_eval
MYSQL_USER=meetingbot_eval
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-root

# ---------- 认证 ----------
JWT_SECRET=replace-with-openssl-rand-hex-32
APP_ADMIN_USERNAME=eval_admin
APP_ADMIN_PASSWORD=change-me-admin
DEMO_PASSWORD=change-me-demo
REGISTER_ENABLED=false
CORS_ALLOW_ORIGINS=

# ---------- 模型（必填 Key） ----------
DASHSCOPE_API_KEY=sk-...
# 可选：ASR 和 LLM 使用不同 Key 时填这两项，留空则共用 DASHSCOPE_API_KEY
ASR_API_KEY=
LLM_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ASR_MODEL=paraformer-v2
LLM_MODEL=qwen3.8-max-0902

# ---------- 行为参数（评测建议固定，方便对比） ----------
MAX_CHUNK_CHARS=6000
AGENT_REVIEW_MAX_TRANSCRIPT_CHARS=100000
CHUNK_SECONDS=1200
SEED_DEMO=1
TZ=Asia/Shanghai

# ---------- 端口与镜像 ----------
EVAL_BACKEND_PORT=19192
EVAL_WEB_PORT=18182
EVAL_BACKEND_IMAGE=meetingbot-aim-local-backend:latest
EVAL_WEB_IMAGE=meetingbot-aim-local-web:latest
DOCS_ENABLED=0
AI_CALL_LOG_RETENTION_DAYS=365
