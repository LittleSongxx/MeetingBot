# AIMeeting 环境变量样例——复制为 .env 后填写真实值。
# .env 含密钥，已被 .gitignore 排除，**严禁提交或打印**（包括历史提交，密钥泄露须立即轮换）。

# --- 必填 ---
# JWT 签名密钥：openssl rand -hex 32 生成；缺失时后端拒绝启动
JWT_SECRET=
# MySQL（compose 同时用这两个值初始化数据库）
MYSQL_DATABASE=ai_meeting
MYSQL_USER=aimeeting
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- 模型访问（DashScope 等）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_API_KEY=
ASR_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max-0902
MINUTES_MODEL=
AGENT_MODEL=
SPEAKER_MODEL=
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
LLM_TIMEOUT_SECONDS=300
ASR_TIMEOUT_SECONDS=600

# --- 管理员引导（首次启动建号/改密；之后可移除）---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=

# --- 可选安全开关 ---
# CORS 允许来源（逗号分隔；同源反代部署可留空表示不允许跨域）
CORS_ALLOW_ORIGINS=*
# 自助注册开关；对外部署建议 false（管理员建号）
REGISTER_ENABLED=true
# 登录限流（15 分钟窗口内最多失败次数）
LOGIN_RATE_MAX_FAILURES=8
LOGIN_RATE_WINDOW_SECONDS=900

# --- 生成参数（与评测侧共用，改动须两边同步）---
LLM_MAX_TOKENS=16384
# 按调用类型分档的输出预算（优先于全局；合并步思考 token 与 JSON 共享预算，
# 全局一档曾是 MINUTES_MERGE 截断的根因）：
# LLM_MAX_TOKENS_MINUTES_MERGE=49152
# 瞬态失败（超时/连接/429/5xx）的重试总次数（含首次）；设 1 即不重试。
# 每次尝试各写一条 ai_call_log，"一行日志=一次真实调用"保持不变：
LLM_MAX_ATTEMPTS=3

# --- 本地 ASR 引擎（可选）---
# TRANSCRIPTION_ENGINE=http            # dashscope（默认）| http（本地侧车）
# ASR_HTTP_URL=http://host.docker.internal:9970/transcribe
# 侧车启动：见 scripts/moss_asr_server.py（FunASR + MOSS-Transcribe-Diarize）
AGENT_REVIEW_MAX_TRANSCRIPT_CHARS=100000
LLM_ENABLE_THINKING=
MODELSCOPE_API_KEY=

# --- 端口 ---
WEB_PORT=18082
BACKEND_PORT=19091

# --- 单次转写时长上限（秒）：说话人分离官方建议 ≤2h，超限预检拒绝 ---
# TRANSCRIPTION_MAX_DURATION_SECONDS=7200
# --- Temporal 调度 ---
# TEMPORAL_ADDRESS=temporal:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=aimeeting
# TEMPORAL_MAX_CONCURRENCY=2
