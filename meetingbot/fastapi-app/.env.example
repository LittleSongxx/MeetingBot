# MeetingBot 环境变量样例——复制为 .env 后填写真实值。
# .env 含密钥，已被 .gitignore 排除，**严禁提交或打印**（包括历史提交，密钥泄露须立即轮换）。

# --- 必填 ---
# JWT 签名密钥：openssl rand -hex 32 生成；缺失时后端拒绝启动
JWT_SECRET=
# MySQL（compose 同时用这两个值初始化数据库）
MYSQL_DATABASE=meetingbot
MYSQL_USER=meetingbot
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# PostgreSQL / ParadeDB（compose 用它初始化；PG_DSN 由 compose 自动拼）
PG_USER=meetingbot
PG_PASSWORD=
PG_DATABASE=meetingbot

# --- 模型访问（DashScope 等）---
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
LLM_API_KEY=
ASR_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-max-0902
MINUTES_MODEL=
AGENT_MODEL=
SPEAKER_MODEL=
ASR_MODEL=qwen-audio-3.1-asr-flash-filetrans
LLM_TIMEOUT_SECONDS=300
ASR_TIMEOUT_SECONDS=600

# --- 管理员引导（首次启动建号/改密；之后可移除）---
APP_ADMIN_USERNAME=admin
# 留空时沿用种子账号 admin/admin，仅限本地演示；公网部署必须设置强密码
APP_ADMIN_PASSWORD=

# --- 可选安全开关 ---
# CORS 允许来源（逗号分隔；同源反代部署留空表示不允许跨域）
CORS_ALLOW_ORIGINS=
# 自助注册开关；个人作品默认关闭，账号由管理员建立
REGISTER_ENABLED=false
# 登录限流（15 分钟窗口内最多失败次数）
LOGIN_RATE_MAX_FAILURES=8
LOGIN_RATE_WINDOW_SECONDS=900

# --- 生成参数（与评测侧共用，改动须两边同步）---
LLM_MAX_TOKENS=16384
# 按调用类型分档的输出预算（优先于全局；合并步思考 token 与 JSON 共享预算，
# 全局一档曾是 MINUTES_MERGE 截断的根因）：
# LLM_MAX_TOKENS_MINUTES_MERGE=49152
# 瞬态失败（超时/连接/429/5xx）的重试总次数（含首次）；设 1 即不重试。
# 每次尝试各写一条 ai_call_log，"一行日志=一次真实调用"保持不变：
LLM_MAX_ATTEMPTS=3

# --- 本地 ASR 引擎（可选）---
# MOSS 本地 SA-ASR 侧车（可选；profile: moss）
# 启用步骤见 docs/MOSS-ASR启用.md：
#   1) .env 设 MOSS_MODEL_HOST_DIR=<含 MOSS-Transcribe-Diarize 权重的目录>
#   2) .env 设 TRANSCRIPTION_ENGINE=http、ASR_HTTP_URL=http://asr-sidecar:9971/transcribe
#   3) ASR_TIMEOUT_SECONDS=2400；TRANSCRIPTION_MAX_DURATION_SECONDS=2700（45min）
#      —— 依据 §48 容量测试：62.87min 合成场峰值显存 98%、RTF 0.73，无放宽余量；>45min 需拆段
#   4) ./scripts/compose.sh build backend temporal-worker
#      ./scripts/compose.sh up -d asr-sidecar backend
#      ./scripts/compose.sh up -d --force-recreate temporal-worker   # 执行侧是 worker，必须一起重建
# TRANSCRIPTION_ENGINE=http
# ASR_HTTP_URL=http://asr-sidecar:9971/transcribe
# ASR_TIMEOUT_SECONDS=2400
# TRANSCRIPTION_MAX_DURATION_SECONDS=2700
# MOSS_MODEL_HOST_DIR=C:/moss-model
# 回滚：TRANSCRIPTION_ENGINE=dashscope（并重启 backend）
AGENT_REVIEW_MAX_TRANSCRIPT_CHARS=100000
LLM_ENABLE_THINKING=
MODELSCOPE_API_KEY=

# --- 可选跨族裁判（自检支撑复核/在线评估）---
# 未配置时产品自动回退 AGENT；建议填与被测不同族的模型。
# JUDGE_MODEL=deepseek-flash
# JUDGE_API_KEY=
# JUDGE_BASE_URL=https://api.deepseek.com
# JUDGE_TIMEOUT_SECONDS=180

# --- 端口 ---
WEB_PORT=18082
BACKEND_PORT=19091

# --- 单次转写时长上限（秒）：说话人分离官方建议 ≤2h，超限预检拒绝 ---
# TRANSCRIPTION_MAX_DURATION_SECONDS=7200
# --- Temporal 调度 ---
# TEMPORAL_ADDRESS=temporal:7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=meetingbot
# TEMPORAL_MAX_CONCURRENCY=2

# --- PostgreSQL（ParadeDB）：LangGraph checkpoint + BM25 词法索引 ---
# 容器内由 compose 注入；本地直跑时按需设置。
# 为空时：BM25 退回 dense-only；checkpoint 不启用。
PG_DSN=
# ParadeDB 中文分词器：jieba（准确，稍慢）/ chinese_lindera / chinese_compatible
KB_BM25_TOKENIZER=jieba
# 词法臂召回候选数（与 dense 各取这么多，再应用层 RRF）
KB_BM25_TOP_K=24
# LangGraph checkpoint 是否启用；生产配了 PG_DSN 后建议 1
CHAT_CHECKPOINT_ENABLED=0
# checkpoint 保留天数（启动时/定时清理；0 = 不清理）
CHECKPOINT_TTL_DAYS=7
# 对话事件流 TTL（秒）：SSE 断线重连窗口
CHAT_EVENT_TTL_SECONDS=3600
# 上下文装配的字符预算（历史 + 计划/覆盖提示；system 与当前问题永远保留）
CHAT_CONTEXT_MAX_CHARS=60000
# outbox 扫描间隔（秒）
KB_OUTBOX_POLL_SECONDS=2

# --- 评测判定（跨族裁判）---
# 只给 evaluation/ 用：**判定模型必须与被测不同族**（评测宪法第 2 条），
# 被测是 qwen3.8-max，所以复判换 DeepSeek。产品自身的模型配置仍由上面的 LLM_* 决定。
# 用法：cd evaluation && PY=../meetingbot/fastapi-app/.venv/bin/python \
#         PYTHONPATH=. $PY judges/rag.py --judge --provider deepseek --label b \
#         --authorized-llm-calls N
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# --- 成本工程：便宜模型用途（可选；填了才会建 CHEAP 配置）---
# 路由表 model_route 指向该配置；不填时所有调用维持原用途模型。
# 便宜模型必须支持 strict json_schema（否则启动校验会拒绝被路由到 MINUTES/AGENT/
# SPEAKER/CHAT_SUMMARY/KB_QUERY_PLAN/KB_CONTEXTUALIZE 的路由）。
CHEAP_MODEL=
CHEAP_API_KEY=
CHEAP_BASE_URL=
CHEAP_TIMEOUT_SECONDS=300
CHEAP_INPUT_PRICE_MICRO_PER_1K=0
CHEAP_OUTPUT_PRICE_MICRO_PER_1K=0

# --- 问答链路的两个可选机制（**默认关**：新机制先量后开）---
# KB_RERANK_ENABLED=1    检索结果用一次 LLM 调用按"能不能回答问题"重排
# KB_QUERY_PLAN_ENABLED=1 相对时间/指代改写 + 意图与建议工具（提示式，不强制）
KB_RERANK_ENABLED=
KB_QUERY_PLAN_ENABLED=

# --- 检索链路（embedding / rerank）---
# 嵌入与 rerank 都可单独指向专属端点；rerank 需 DashScope 原生 API 路径（/api/v1）
EMBEDDING_MODEL=qwen3.7-text-embedding
# pgvector 列与 HNSW 索引的维度；改它必须重建知识库
EMBEDDING_DIM=1024
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=
KB_RERANK_ENABLED=1
# rerank 候选深度（混合召回两路 prefetch 与融合后的 limit 同步放大）。
# 24 是默认；40 的对照只改这一个值。
RERANK_CANDIDATES=24
# rerank 输入单价（微元/千 token；0 = 未定价）。公开价 0.5 元/百万输入 token
# = 500 微元/千 token；以本账号账单为准，改价只影响之后的调用。
RERANK_INPUT_PRICE_MICRO_PER_1K=500

# --- RAG 全链路参数（标准漏斗：混合召回 → 专用重排 → 截断）---
# 窗口字数：本语料标定 300（500×5→300×3 让 precision 53%→81%，recall 保持 95.2%）
KB_CHUNK_TARGET_CHARS=300
# 重排后交给生成模型的最大条数（漏斗截断口；实测 300 字下 k=3 的 precision 远高于 k=5）
RERANK_TOP_K=3
# 重叠窗口去重：默认关。300×3 的零调用反事实里，删掉的 10 条上下文全部被判有用，
# precision 反而从 81.0% 降到 78.4%；只有"重叠比例接近 1"的切法才值得开。
KB_DEDUPE_ENABLED=0
KB_DEDUPE_OVERLAP_SECONDS=30
KB_DEDUPE_OVERLAP_RATIO=0.25
# Contextual Retrieval：索引时逐块生成一句"这段在会里的位置/主题"再嵌入。
# 默认关（要重建索引 + 每块一次模型调用）；量到收益后再改默认。
KB_CONTEXTUAL_ENABLED=0
# get_transcript_excerpt 的每轮总片段预算：单次上限管不住多次调用（扩展集 q90 两次 112 段）。
EXCERPT_SEGMENTS_PER_TURN=30
# 换嵌入模型/合集名会由内容指纹触发重建，不需要手动删库

# 生成后引用绑定（预注册 §49）：默认关；30 题 A/B 通过后开
# CHAT_CITATION_BIND_ENABLED=1

# 系列/状态覆盖（预注册 §50）：默认关；A/B 通过后开
# CHAT_STATE_COVERAGE_ENABLED=1
