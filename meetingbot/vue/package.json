    "@wangeditor/editor-for-vue": "^5.1.12",
    "axios": "^1.7.2",
    "dompurify": "^3.4.17",
    "echarts": "^5.6.0",
    "element-plus": "^2.8.4",
    "markdown-it": "^15.0.3",
    "vue": "^3.4.29",
    "vue-router": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
