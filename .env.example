# =============================================================================
# AI 会议纪要助手（MeetingBot）本地部署变量示例
#
# 用法：cp .env.example .env，再按本文件注释修改；.env 已被 .gitignore 忽略，
#       不要提交。compose 用这份 .env 做端口/口令插值，backend 容器通过
#       env_file 读取全部变量。变量含义与必填项说明详见 DEPLOYMENT.md。
#
# 本文件只放占位值，不带任何真实密钥。
# =============================================================================

# ---------------- MySQL ----------------
# 容器内连接信息：compose 里 backend 固定覆盖为 MYSQL_HOST=db、MYSQL_PORT=3306
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=ai_meeting
MYSQL_USER=meetingbot
# 必填：应用账号口令。空数据卷首次启动时生效，之后改这里不会改已有库口令
MYSQL_PASSWORD=change-me
# 必填：root 口令，仅本机 compose 使用
MYSQL_ROOT_PASSWORD=change-me-root
# 是否打印 SQL（排查用，生产保持 false）
SQL_ECHO=false

# ---------------- 认证 ----------------
# 必填：JWT 签名密钥，用 `openssl rand -hex 32` 生成；换值会让已签发的 Token 全部失效
JWT_SECRET=change-me-32-bytes
JWT_EXPIRE_HOURS=24
# 首次启动由 bootstrap.py 创建的管理员账号；APP_ADMIN_PASSWORD 必填，不要用示例值
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me
# 是否开放注册接口；本地演示可设 true，生产保持 false
REGISTER_ENABLED=false
# CORS 允许来源（逗号分隔）；同源部署（nginx 反代）留空即可
CORS_ALLOW_ORIGINS=

# ---------------- 模型服务（bootstrap.py 写入 4 条模型配置） ----------------
# 百炼 API Key。留空时服务能启动、页面能浏览，但转写/纪要/自检调用会失败。
DASHSCOPE_API_KEY=
# 百炼录音文件识别（ASR）地址，对应 provider=DASHSCOPE
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# OpenAI 兼容地址，纪要/自检/说话人匹配共用
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
ASR_MODEL=paraformer-v2
LLM_TIMEOUT_SECONDS=600
ASR_TIMEOUT_SECONDS=600

# ---------------- 行为参数 ----------------
# 纪要生成：单次请求送进模型的最大转写字符数
MAX_CHUNK_CHARS=12000
# 纪要自检：送给审查模型的最大转写字符数（超出截断，避免超长上下文）
AGENT_REVIEW_MAX_TRANSCRIPT_CHARS=20000
# 转写：FFmpeg 单个音频分段的秒数
CHUNK_SECONDS=1200
# 日志：INFO/DEBUG/WARNING；text 便于本地看，json 便于采集
LOG_LEVEL=INFO
LOG_FORMAT=text
# 1=首次启动补一份演示会议数据；0=不生成
SEED_DEMO=1
# SEED_DEMO=1 时演示账号使用的口令
DEMO_PASSWORD=change-me
# 容器时区（页面提交与展示均为东八区时间）
TZ=Asia/Shanghai

# ---------------- 宿主机端口（只绑定 127.0.0.1） ----------------
BACKEND_PORT=19092
WEB_PORT=18083
