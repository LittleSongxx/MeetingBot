# =============================================================================
# AI 会议纪要助手（原版课程项目）本地部署变量示例
#
# 用法：cp .env.example .env，按注释修改；.env 已被 .gitignore 忽略，不要提交。
# compose 用这份 .env 做端口/口令插值，backend 容器通过 env_file 读取全部变量。
# 本文件只放占位值，不带任何真实密钥。
# =============================================================================

# ---------------- MySQL ----------------
# 本机开发时后端直连 localhost；compose 里 backend 固定覆盖为 MYSQL_HOST=db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_meeting
MYSQL_USER=meetingbot
# 必填：应用账号口令（空数据卷首次启动时生效）
MYSQL_PASSWORD=change-me
# 必填：root 口令，仅本机 compose 使用
MYSQL_ROOT_PASSWORD=change-me-root
# 是否打印 SQL（排查用，正常保持 false）
SQL_ECHO=false

# ---------------- 认证 ----------------
# JWT 签名密钥；留空时源码里的默认值生效（生产必须覆盖）
JWT_SECRET=change-me-32-bytes
JWT_EXPIRE_HOURS=24

# ---------------- 时区 ----------------
TZ=Asia/Shanghai

# ---------------- 宿主机端口（只绑定 127.0.0.1）----------------
BACKEND_PORT=19092
WEB_PORT=18083
