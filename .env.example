# 仅在使用 docker compose 直接调用时需要根级插值；推荐 ./scripts/compose.sh
# （它统一读取 meetingbot/fastapi-app/.env，根 .env 不参与）。
MYSQL_DATABASE=meetingbot
MYSQL_USER=meetingbot
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
# PostgreSQL（ParadeDB）：BM25 词法索引 + LangGraph checkpoint
PG_USER=meetingbot
PG_PASSWORD=change-me
PG_DATABASE=meetingbot
# openssl rand -hex 32；不要使用示例值
JWT_SECRET=change-me-32-bytes-min
# 同源反代部署留空；跨域时填逗号分隔来源
CORS_ALLOW_ORIGINS=
REGISTER_ENABLED=false
BACKEND_PORT=19091
WEB_PORT=18082
