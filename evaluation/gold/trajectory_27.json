{
  "name": "Agent 轨迹金标 27 题（代理起草启发式；不是人工金标）",
  "purpose": "评测 Agent 一次问答的**工具轨迹**：首轮工具 strict/acceptable、工具调用集合 precision/recall/F1、必引率、强制工具覆盖率、禁止工具命中、pass^k。零模型调用，读 judges/rag.py --ask 产物。",
  "label_source": "agent_draft_heuristic_with_ai_reviewed_labels",
  "human_checked": false,
  "discipline": "label_source=agent_draft_heuristic：意图与 required/acceptable 工具按问题文本启发式映射，不是人工金标；读数只用于方向回归，进入产品决策前须经人工确认。不报加权总分，逐项报并带样本量。",
  "source_sets": [
    "gold/qa_seed.json（问题文本逐字取自该集；含人工 27 条与扩展集）",
    "evaluation/gold/tool_choice_50.json（首轮工具口径来源）"
  ],
  "artifact_contract": {
    "producer": "judges/rag.py --ask（artifact_version=1）",
    "turn_fields": [
      "case_id",
      "question",
      "answer",
      "stop_reason",
      "citations",
      "tools"
    ],
    "tool_name_path": "turns[].tools[].name",
    "trial": "同一 question 在传入产物中出现一次 = 一次 trial；多文件按传入次序各算一次 trial。首轮工具与工具集合指标取每题第一次 trial；pass^k 取前 k 次 trial。",
    "tool_success_note": "工具是否执行成功（tools[].ok）不参与 required 覆盖判定：这里评的是模型是否选择了该工具；执行成功率不在本仪器口径内。"
  },
  "intent_taxonomy": {
    "single_fact": "单点事实，路由检索",
    "aggregation": "枚举/聚合，路由已确认清单",
    "cross_meeting": "跨两段录音/两场会汇总，需多来源检索",
    "smalltalk": "寒暄/域外，不调工具",
    "state": "查系列/个人已确认状态（上次待办/负责人/之前决定），路由 query_meeting_state"
  },
  "tool_taxonomy": {
    "search_knowledge": "混合检索会议知识库，返回带出处的切片（单点事实/原文引用）。",
    "list_facts": "按类别列已确认纪要里的结构化事实（决策/待办/风险/会议清单）。",
    "get_minutes": "按需取某场会的纪要字段（摘要/议题/观点/决策/待办/风险）。",
    "get_transcript_excerpt": "按时间窗口取转写原文片段，把引用落到具体句子。",
    "query_meeting_state": "查系列/个人已确认状态（决策/结论/待办及完成情况/偏好）；问「上次定了什么」「还有哪些待办」「谁负责」「现在什么状态」先用它。"
  },
  "validation_rules": {
    "single_fact": "search_knowledge ∈ required_tools",
    "aggregation": "list_facts ∈ required_tools",
    "cross_meeting": "cross_meeting=true 且 search_knowledge ∈ required_tools 且 min_tool_calls>=2",
    "smalltalk": "required_tools=[] 且 max_tool_calls=0 且 must_cite=false",
    "state": "query_meeting_state ∈ required_tools",
    "common": "required_tools ⊆ acceptable_tools；required∩forbidden=∅；工具名都在 tool_taxonomy 里"
  },
  "field_notes": {
    "min_tool_calls": "该题最少工具调用次数；cross_meeting 用 2 表达「至少 2 次检索或 search+list_facts」，smalltalk 用 0 表达不调工具。",
    "must_cite": "回答是否必须带 citations（快照非空）；smalltalk 不要求。",
    "cross_meeting": "是否必须跨两段录音取证。"
  },
