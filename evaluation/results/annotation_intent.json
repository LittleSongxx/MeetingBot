{
  "packet_version": 1,
  "protocol": "verification",
  "why": "意图标签决定路由走向，而路由判错比不路由更糟；因此先取独立人工标注，再谈逐类 F1。代理标签（intent_source=agent_draft）不放进包里，避免锚定。",
  "labels_allowed": [
    "single_fact",
    "aggregation",
    "cross_meeting",
    "smalltalk"
  ],
  "criteria": [
    {
      "label": "single_fact",
      "meaning": "问一个具体事实（时间、数值、负责人、某一条决定、流程解释）",
      "criterion": "答案是一句话能说清的一个事实/一段流程，不需要罗列。例：发布公告的截止时间是什么"
    },
    {
      "label": "aggregation",
      "meaning": "枚举/聚合：问「有哪些」「哪几项」「分别是什么」",
      "criterion": "答案天然是列表（≥2 项）。例：首周复盘要看哪五项数据"
    },
    {
      "label": "cross_meeting",
      "meaning": "跨会议（本语料是跨两段录音）汇总",
      "criterion": "答案必须来自两段录音，或多场会议的比较/汇总。例：两段录音里的风险分别是什么"
    },
    {
      "label": "smalltalk",
      "meaning": "寒暄或与会议无关的请求",
      "criterion": "答案不该来自会议资料（打招呼、道谢、问能力边界、问天气）。这一类没有金标事实"
    }
  ],
  "annotators_required": 3,
